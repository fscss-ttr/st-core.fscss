    @import((*) from st-core@v2)
    @import((*) from circle-progress)
    @import((*) from icon-mask)

    /* ========== TOKENS ========== */
    @st-root()
    @progress-root()
    @icon-pack()

    :root {
      --st-bg:        #0b0c10;
      --st-surface:   #12131a;
      --st-card:      #181924;
      --st-accent:    #22c55e;
      --st-accent-2:  #4ade80;
      --st-green:     #22c55e;
      --st-text:      #f1f5f9;
      --st-muted:     #94a3b8;
      --st-border:    rgba(255,255,255,0.08);
      --st-radius-lg: 16px;
      --st-radius-md: 12px;
      --st-pad:       20px;

      --progress-color-bg:    #12131a;
      --progress-color-track: rgba(255,255,255,0.08);
      --progress-color-value: #f1f5f9;
      --progress-size:        140px;
      --progress-stroke:      16px;

      @icon-color(#94a3b8)
      @icon-size(20px)
    }

    /* ========== RESET & BASE ========== */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      background: var(--st-bg);
      color: var(--st-text);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      display: flex;
    }

    /* ========== SIDEBAR ========== */
    .sidebar {
      width: 240px;
      background: var(--st-surface);
      border-right: 1px solid var(--st-border);
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .logo {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 32px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .logo .icon { @icon-color(#22c55e) @icon-size(24px) }

    .nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }
    .nav a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-radius: 10px;
      color: var(--st-muted);
      text-decoration: none;
      font-size: 0.92rem;
      transition: all 0.2s;
    }
    .nav a:hover,
    .nav a.active {
      background: rgba(34,197,94,0.12);
      color: #fff;
    }
    .nav a.active .icon { @icon-color(#22c55e) }
    .nav a:hover .icon { @icon-color(#fff) }

    .sidebar-footer {
      border-top: 1px solid var(--st-border);
      padding-top: 16px;
      margin-top: 16px;
    }

    /* ========== MAIN ========== */
    .main {
      flex: 1;
      padding: 24px 28px;
      overflow-y: auto;
    }

    /* Header */
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      gap: 12px;
    }
    .topbar h1 { font-size: 1.45rem; font-weight: 700; }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .topbar-left h1 {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-shrink: 0;
    }
    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--st-card);
      border: 1px solid var(--st-border);
      display: grid;
      place-items: center;
      cursor: pointer;
      position: relative;
      flex-shrink: 0;
    }
    .icon-btn .badge-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
    }

    /* Mobile menu button (hidden on desktop) */
    .menu-btn {
      display: none;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--st-card);
      border: 1px solid var(--st-border);
      place-items: center;
      cursor: pointer;
      flex-shrink: 0;
    }

    /* Sidebar backdrop for mobile */
    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 90;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .sidebar-backdrop.open {
      display: block;
      opacity: 1;
    }

    /* Profile dropdown */
    .profile {
      position: relative;
    }
    .profile-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--st-card);
      border: 1px solid var(--st-border);
      padding: 6px 12px 6px 6px;
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #22c55e, #3b82f6);
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 0.85rem;
      flex-shrink: 0;
    }
    .dropdown {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      background: var(--st-card);
      border: 1px solid var(--st-border);
      border-radius: 12px;
      min-width: 180px;
      padding: 8px;
      display: none;
      z-index: 50;
      box-shadow: 0 12px 40px rgba(0,0,0,0.4);
    }
    .dropdown.open { display: block; }
    .dropdown a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      color: var(--st-text);
      text-decoration: none;
      font-size: 0.9rem;
    }
    .dropdown a:hover { background: rgba(255,255,255,0.06); }

    /* ========== GRID ========== */
    .grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 24px;
    }

    /* Cards */
    .card {
      background: var(--st-card);
      border: 1px solid var(--st-border);
      border-radius: var(--st-radius-lg);
      padding: 22px;
      min-width: 0;
    }
    .card-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 4px; }
    .card-sub { font-size: 0.85rem; color: var(--st-muted); margin-bottom: 18px; }

    /* Stat cards row */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }
    .stat-card {
      background: var(--st-card);
      border: 1px solid var(--st-border);
      border-radius: var(--st-radius-lg);
      padding: 18px;
      min-width: 0;
    }
    .stat-card .label {
      font-size: 0.8rem;
      color: var(--st-muted);
      margin-bottom: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .stat-card .value { font-size: 1.5rem; font-weight: 700; }
    .stat-card .delta { font-size: 0.8rem; margin-top: 6px; }
    .delta.up { color: #4ade80; }
    .delta.down { color: #f87171; }

    /* ========== REVENUE CHART ========== */
    @arr data7d[42, 58, 65, 60, 78, 70, 92]
    @arr data30d[35, 48, 55, 62, 58, 70, 75, 68, 80, 85]
    @arr data90d[30, 40, 45, 50, 55, 60, 58, 65, 70, 75, 80, 85]

    @st-chart-fill(.rev-fill, data7d)
    @st-chart-line(.rev-line, data7d)
    @st-chart-grid(.rev-grid, 5, 7)

    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .tabs { display: flex; gap: 6px; }
    .tab {
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.8rem;
      background: transparent;
      color: var(--st-muted);
      border: 1px solid transparent;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab.active {
      background: #fff;
      color: #0f172a;
      font-weight: 600;
    }

    .legend {
      display: flex;
      gap: 16px;
      margin-bottom: 10px;
      font-size: 0.8rem;
      color: var(--st-muted);
    }
    .legend span::before {
      content: '';
      display: inline-block;
      width: 8px; height: 8px;
      border-radius: 50%;
      margin-right: 6px;
    }
    .legend .rev::before { background: #22c55e; }

    .chart-wrap {
      position: relative;
      height: 260px;
    }
    .chart {
      @st-chart-points(data7d)
      position: relative;
      height: 220px;
    }
    .rev-fill {
      --st-accent: #22c55e;
      opacity: 0.22;
      transition: clip-path 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .rev-line {
      --st-accent: #22c55e;
      @st-chart-line-width(2.5px)
      transition: clip-path 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .rev-grid { opacity: 0.12; }

    /* Axis labels */
    .y-labels {
      position: absolute;
      left: 0; top: 0; bottom: 30px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      font-size: 0.7rem;
      color: var(--st-muted);
      pointer-events: none;
    }
    .x-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: var(--st-muted);
      margin-top: 8px;
      padding: 0 4px;
    }

    /* ========== TRAFFIC + GOALS ========== */
    @circle-pie-multi(.traffic-pie)

    .traffic-body {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .traffic-pie {
      --progress-size: 140px;
      --pie-a: 45; --pie-b: 30; --pie-c: 15; --pie-d: 10;
      --progress-color-arc: #22c55e;
      --progress-arc-2: #3b82f6;
      --progress-arc-3: #8b5cf6;
      --progress-arc-4: #f59e0b;
      position: relative;
      flex-shrink: 0;
    }
    .traffic-pie::after {
      content: '';
      position: absolute;
      inset: 22%;
      border-radius: 50%;
      background: var(--st-card);
    }
    .pie-center {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      text-align: center;
      z-index: 2;
      pointer-events: none;
    }
    .pie-center strong { font-size: 1.5rem; font-weight: 700; }
    .pie-center span { font-size: 0.72rem; color: var(--st-muted); }

    .traffic-legend {
      display: flex;
      flex-direction: column;
      gap: 9px;
      font-size: 0.88rem;
      flex: 1;
      min-width: 0;
    }
    .traffic-legend div {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .dot.green  { background: #22c55e; }
    .dot.blue   { background: #3b82f6; }
    .dot.purple { background: #8b5cf6; }
    .dot.orange { background: #f59e0b; }
    .traffic-legend .pct {
      margin-left: auto;
      color: var(--st-muted);
      font-variant-numeric: tabular-nums;
    }

    /* Goals bars */
    .goals-list { display: flex; flex-direction: column; gap: 16px; }
    .goal-item { display: flex; flex-direction: column; gap: 6px; }
    .goal-head {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
    }
    .goal-head span:last-child { color: var(--st-muted); }
    .bar-track {
      height: 8px;
      background: rgba(255,255,255,0.08);
      border-radius: 999px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #22c55e, #4ade80);
      transition: width 0.8s ease;
    }

    /* ========== MESSAGES / ACTIVITIES ========== */
    .list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .list-item {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--st-border);
    }
    .list-item:last-child { border-bottom: none; padding-bottom: 0; }
    .list-item .avatar-sm {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: #334155;
      display: grid;
      place-items: center;
      font-size: 0.8rem;
      font-weight: 600;
      flex-shrink: 0;
    }
    .list-item .meta { flex: 1; min-width: 0; }
    .list-item .name { font-weight: 600; font-size: 0.9rem; }
    .list-item .msg {
      font-size: 0.82rem;
      color: var(--st-muted);
      margin-top: 2px;
      overflow-wrap: break-word;
    }
    .list-item .time { font-size: 0.75rem; color: var(--st-muted); flex-shrink: 0; }

    /* Table */
    .table-card { grid-column: 1 / -1; margin-top: 8px; }
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th {
      text-align: left;
      padding: 12px 14px;
      color: var(--st-muted);
      font-weight: 500;
      border-bottom: 1px solid var(--st-border);
      white-space: nowrap;
    }
    td {
      padding: 13px 14px;
      border-bottom: 1px solid var(--st-border);
      white-space: nowrap;
    }
    tr:last-child td { border-bottom: none; }
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .badge.up   { background: rgba(34,197,94,0.15); color: #4ade80; }
    .badge.down { background: rgba(239,68,68,0.15); color: #f87171; }

    /* ========== RESPONSIVE ========== */

    /* Tablet / below sidebar breakpoint: off-canvas sidebar */
    @media (max-width: 1100px) {
      .menu-btn { display: grid; }

      .sidebar {
        display: flex;
        position: fixed;
        left: 0;
        top: 0;
        z-index: 100;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        box-shadow: 0 0 40px rgba(0,0,0,0.5);
      }
      .sidebar.open { transform: translateX(0); }

      .grid { grid-template-columns: 1fr; }
    }

    /* Phone */
    @media (max-width: 640px) {
      .main { padding: 16px; }
      .topbar { margin-bottom: 20px; }
      .topbar h1 { font-size: 1.1rem; }

      .profile-btn { padding: 6px; }
      .profile-btn > :not(.avatar) { display: none; }

      .stats { grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 18px; }
      .stat-card { padding: 14px; }
      .stat-card .value { font-size: 1.2rem; }

      .card { padding: 16px; }

      .chart-wrap { height: 220px; }
      .chart { height: 180px; }
      .y-labels { display: none; }
      .chart-header { align-items: center; }

      .traffic-body { flex-direction: column; align-items: flex-start; gap: 16px; }
      .traffic-pie { margin: 0 auto; }

      .table-card { padding: 16px; }
    }

    @media (max-width: 380px) {
      .stats { grid-template-columns: 1fr; }
      .tabs { width: 100%; justify-content: space-between; }
      .tab { flex: 1; text-align: center; padding: 6px 8px; }
    }
