{
  "name": "st-core",
  "version": "2",
  "description": "Lightweight FSCSS - based UI library for statistical dashboard and components",
  "extension": "fscss",
  "fscss_version": "^1.2.3",
  "blocked_methods": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/fscss-ttr/st-core.fscss"
  },
  "bugs": {
    "url": "https://github.com/fscss-ttr/st-core.fscss/issues"
  },
  "file": {
    "usage": {
      "directive": "st-*",
      "helpers": [
        "st-root",
        "st-container",
        "st-phone",
        "st-chart",
        "st-chart-fill",
        "st-chart-line",
        "st-chart-dot",
        "st-chart-dots",
        "st-chart-points",
        "st-chart-line-width",
        "st-chart-grid",
        "st-chart-axis-x",
        "st-chart-axis-y",
        "st-stat-card",
        "st-cat-bar-fill",
        "st-spider-root",
        "st-spider-points",
        "st-spider-fill",
        "st-spider-line",
        "st-spider-dots",
        "st-spider-grid",
        "st-spider-spokes",
        "st-spider-spokes-n"
      ]
    },
    "modules": [
      "./st-core@v2.fscss"
    ],
    "remote": "./st-core@v2.fscss"
  },
  "author": {
    "name": "fscss-ttr"
  },
  "keywords": [
    "fscss",
    "css",
    "lightweight",
    "fscss-based",
    "dashboard-ui",
    "utility",
    "statistics",
    "spider-chart",
    "radar-chart"
  ],
  "license": "MIT"
}
